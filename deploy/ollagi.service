# A systemd *user* service: it runs as me, starts when I log in and stops when I log out.
# Install (links this file, so later edits apply after `systemctl --user daemon-reload`):
#   systemctl --user enable --now /run/media/oll/Linux/Projects/ollagi/deploy/ollagi.service
# Logs:    journalctl --user -u ollagi -f
# Stop:    systemctl --user stop ollagi
#
# Stopping or restarting this service does not stop Claude sessions: each session lives in its own
# systemd scope (docs/decisions/0005), outside this service's group.

[Unit]
Description=ollagi web page for Claude Code sessions
After=network-online.target

[Service]
# The repo sits on a drive the desktop mounts at login, which can be a few seconds after this
# service is started. If the program is not there yet, systemd retries every 10 seconds.
ExecStart=/run/media/oll/Linux/Projects/ollagi/.venv/bin/ollagi serve
Restart=on-failure
RestartSec=10s
# A service does not get my shell's PATH; the tools ollagi runs (claude, tmux, tailscale,
# systemd-run) all live in /usr/bin.
Environment=PATH=/usr/local/bin:/usr/bin
# Print immediately instead of buffering, so `journalctl --user -u ollagi` shows the startup lines.
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
